<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- D-W8-27: as values/, and the system never darkens or lightens the app for us. -->
    <style name="Theme.TVora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tvora_window</item>
        <item name="android:colorBackground">@color/tvora_window</item>
        <item name="android:statusBarColor">@color/tvora_window</item>
        <item name="android:navigationBarColor">@color/tvora_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
